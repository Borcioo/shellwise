---
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

export async function getStaticPaths() {
	const rules = await getCollection('rules');
	return rules.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<StarlightPage
	frontmatter={{ title: entry.id, description: `What the shellwise rule ${entry.id} catches.` }}
	headings={headings.filter((heading) => heading.depth > 1)}
>
	<div class="source-doc"><Content /></div>
</StarlightPage>
