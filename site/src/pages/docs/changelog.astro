---
import { getEntry, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const entry = await getEntry('repo', 'CHANGELOG.md');
if (!entry) throw new Error('CHANGELOG.md was not loaded');
const { Content, headings } = await render(entry);
---

<StarlightPage
	frontmatter={{ title: 'Changelog', description: 'What changed in each shellwise release.' }}
	headings={headings.filter((heading) => heading.depth === 2)}
>
	<div class="source-doc"><Content /></div>
</StarlightPage>
