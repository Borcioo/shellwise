{
  "description": "Run shellwise on each Bash and PowerShell command, and check for a newer shellwise once a day",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "shellwise",
            "args": ["hook", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "shellwise",
            "args": ["update", "--notify"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
